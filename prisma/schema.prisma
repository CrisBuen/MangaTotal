generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int               @id @default(autoincrement())
  nickname             String            @unique
  email                String?           @unique
  emailVerifiedAt      DateTime?         @map("email_verified_at")
  passwordHash         String            @map("password_hash")
  sessionVersion       Int               @default(1) @map("session_version")
  birthdate            DateTime?
  isAdmin              Boolean           @default(false) @map("is_admin")
  showAdultContent     Boolean           @default(false) @map("show_adult_content")
  animeEnabled         Boolean           @default(false) @map("anime_enabled")
  animeTermsAcceptedAt DateTime?         @map("anime_terms_accepted_at")
  preferredReadingMode String            @default("cascade") @map("preferred_reading_mode")
  avatarPath           String?           @map("avatar_path")
  createdAt            DateTime          @default(now()) @map("created_at")
  progress             ReadingProgress[]
  favorites            Favorite[]
  animeEntries         AnimeEntry[]
  externalAnime        ExternalAnime[]
  externalSeries       ExternalSeries[]
  accountTokens        AccountToken[]

  @@map("users")
}

/// Tokens de un solo uso para verificar correo y recuperar contraseña.
/// Nunca se guarda el valor enviado por correo: solamente su hash SHA-256.
model AccountToken {
  id        String    @id @default(cuid())
  userId    Int       @map("user_id")
  kind      String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
  @@index([expiresAt])
  @@map("account_tokens")
}

/// Contadores de abuso de autenticación. La clave es un HMAC: no guarda en
/// claro ni la IP ni el apodo usados durante un intento.
model AuthRateLimit {
  key             String    @id
  attempts        Int       @default(0)
  windowStartedAt DateTime  @map("window_started_at")
  blockedUntil    DateTime? @map("blocked_until")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([updatedAt])
  @@map("auth_rate_limits")
}

/// Presencia anónima de una instalación. No guarda cuenta, IP, apodo ni la
/// obra exacta: alcanza para saber cuánta gente está activa y en qué sección.
model AnalyticsPresence {
  visitorId String   @id @map("visitor_id")
  section   String
  source    String?
  platform  String
  firstSeen DateTime @default(now()) @map("first_seen")
  lastSeen  DateTime @default(now()) @map("last_seen")

  @@index([lastSeen])
  @@index([source, lastSeen])
  @@index([section, lastSeen])
  @@map("analytics_presence")
}

/// Aperturas reales de capítulos y episodios. El dedupeKey limita recargas
/// repetidas dentro de la misma ventana sin conservar la ruta del contenido.
model AnalyticsEvent {
  id         BigInt   @id @default(autoincrement())
  visitorId  String   @map("visitor_id")
  eventType  String   @map("event_type")
  section    String
  source     String?
  platform   String
  dedupeKey  String   @unique @map("dedupe_key")
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@index([occurredAt])
  @@index([eventType, occurredAt])
  @@index([source, occurredAt])
  @@map("analytics_events")
}

model Series {
  id             Int               @id @default(autoincrement())
  title          String
  originalTitle  String?           @map("original_title")
  slug           String            @unique
  type           String            @default("normal") // normal | adult
  description    String?
  coverImagePath String?           @map("cover_image_path")
  status         String            @default("ongoing") // ongoing | completed | dropped
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  chapters       Chapter[]
  favorites      Favorite[]
  progress       ReadingProgress[]
  ingestionJobs  IngestionJob[]
  tags           Tag[]

  @@index([type])
  @@map("series")
}

/// Seguimiento de anime del usuario (catálogo de AniList, sin alojar video).
model AnimeEntry {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  anilistId       Int      @map("anilist_id")
  title           String
  coverUrl        String?  @map("cover_url")
  totalEpisodes   Int?     @map("total_episodes")
  status          String   @default("watching") // watching | planned | completed | dropped
  episodesWatched Int      @default(0) @map("episodes_watched")
  score           Int?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, anilistId])
  @@index([userId, status])
  @@map("anime_entries")
}

/// Anime guardado desde fuentes externas reproducibles. No se aloja video:
/// solo la referencia a la ficha original de cada proveedor.
model ExternalAnime {
  id                Int                            @id @default(autoincrement())
  userId            Int                            @map("user_id")
  source            String
  externalId        String                         @map("external_id")
  slug              String?
  title             String
  coverUrl          String?                        @map("cover_url")
  type              String?
  status            String?
  totalEpisodes     Int?                           @map("total_episodes")
  isAdult           Boolean                        @default(false) @map("is_adult")
  saved             Boolean                        @default(true)
  lastEpisodeId     String?                        @map("last_episode_id")
  lastEpisodeNumber String?                        @map("last_episode_number")
  lastEpisodeTitle  String?                        @map("last_episode_title")
  lastWatchedAt     DateTime?                      @map("last_watched_at")
  createdAt         DateTime                       @default(now()) @map("created_at")
  updatedAt         DateTime                       @updatedAt @map("updated_at")
  user              User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodeProgress   ExternalAnimeEpisodeProgress[]

  @@unique([userId, source, externalId])
  @@index([userId, updatedAt])
  @@index([userId, saved, updatedAt])
  @@map("external_anime")
}

/// Minuto visto por episodio de una fuente animada. Las URLs temporales del
/// video nunca llegan a esta tabla: solo se recuerda el progreso del usuario.
model ExternalAnimeEpisodeProgress {
  id              Int           @id @default(autoincrement())
  externalAnimeId Int           @map("external_anime_id")
  episodeId       String        @map("episode_id")
  episodeNumber   String        @map("episode_number")
  episodeTitle    String?       @map("episode_title")
  positionSeconds Int           @default(0) @map("position_seconds")
  durationSeconds Int           @default(0) @map("duration_seconds")
  completed       Boolean       @default(false)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  externalAnime   ExternalAnime @relation(fields: [externalAnimeId], references: [id], onDelete: Cascade)

  @@unique([externalAnimeId, episodeId])
  @@index([externalAnimeId, updatedAt])
  @@map("external_anime_episode_progress")
}

/// Series de fuentes externas (MangaDex, Olympus) guardadas por el usuario,
/// con el capítulo por el que va. No se aloja contenido: solo la referencia.
model ExternalSeries {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  source          String
  externalId      String   @map("external_id")
  slug            String?
  title           String
  coverUrl        String?  @map("cover_url")
  type            String?
  lastChapterId   String?  @map("last_chapter_id")
  lastChapterName String?  @map("last_chapter_name")
  lastPageNumber  Int?     @map("last_page_number")
  /// true = está en la biblioteca; false = solo quedó en el historial de
  /// lectura, porque abrió un capítulo pero no llegó a guardarla.
  saved           Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, externalId])
  @@index([userId, saved, updatedAt])
  @@map("external_series")
}

model Tag {
  id     Int      @id @default(autoincrement())
  name   String   @unique
  slug   String   @unique
  series Series[]

  @@map("tags")
}

model Chapter {
  id            Int               @id @default(autoincrement())
  seriesId      Int               @map("series_id")
  number        Float
  title         String?
  sourceZipName String            @map("source_zip_name")
  pageCount     Int               @default(0) @map("page_count")
  uploadedAt    DateTime          @default(now()) @map("uploaded_at")
  series        Series            @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  pages         Page[]
  progress      ReadingProgress[]
  ingestionJobs IngestionJob[]

  @@index([seriesId, number])
  @@map("chapters")
}

model Page {
  id             Int     @id @default(autoincrement())
  chapterId      Int     @map("chapter_id")
  pageNumber     Int     @map("page_number")
  filePath       String  @map("file_path")
  width          Int
  height         Int
  fileSizeBytes  Int     @map("file_size_bytes")
  checksumSha256 String  @map("checksum_sha256")
  chapter        Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId, pageNumber])
  @@map("pages")
}

model ReadingProgress {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  seriesId       Int      @map("series_id")
  chapterId      Int      @map("chapter_id")
  lastPageNumber Int      @map("last_page_number")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  series         Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  chapter        Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, seriesId])
  @@index([userId, updatedAt])
  @@map("reading_progress")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  seriesId  Int      @map("series_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([userId, seriesId])
  @@map("favorites")
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("announcements")
}

model IngestionJob {
  id               Int       @id @default(autoincrement())
  originalFilename String    @map("original_filename")
  status           String    @default("pending") // pending | processing | success | error
  errorMessage     String?   @map("error_message")
  seriesId         Int?      @map("series_id")
  chapterId        Int?      @map("chapter_id")
  startedAt        DateTime  @default(now()) @map("started_at")
  finishedAt       DateTime? @map("finished_at")
  series           Series?   @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  chapter          Chapter?  @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  @@map("ingestion_jobs")
}
