{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MangaTotal",
  "version": "1.7.0",
  "identifier": "app.mangatotal.desktop",
  "build": {
    "frontendDist": "https://www.mangatotal.com"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MangaTotal",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "copyright": "MangaTotal",
    "shortDescription": "Biblioteca de manga y anime",
    "longDescription": "MangaTotal: tu biblioteca de manga, manhwa, manhua y seguimiento de anime.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false,
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "compression": "lzma"
      }
    },
    "publisher": "MangaTotal",
    "homepage": "https://www.mangatotal.com",
    "category": "Entertainment"
  }
}
