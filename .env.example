# Copiar a .env (local) o configurar en Vercel → Settings → Environment Variables.
# Nunca commitear .env con valores reales.

# Postgres (Neon, Supabase, Vercel Postgres...). En producción es obligatorio.
DATABASE_URL="postgresql://usuario:password@host:5432/basededatos?sslmode=require"

# Mínimo 32 caracteres aleatorios (ej: `openssl rand -base64 32`).
SESSION_SECRET="cadena-larga-aleatoria-de-al-menos-32-caracteres"

# Proveedor de almacenamiento de imágenes:
#   "r2"    → Cloudflare R2 (requiere las 4 variables R2_*)
#   "blob"  → Vercel Blob (requiere BLOB_READ_WRITE_TOKEN)
#   "local" → carpeta storage/ (solo desarrollo)
STORAGE_PROVIDER="r2"

# Vercel Blob: aun con R2 se usa como buzón temporal de los .zip subidos.
BLOB_READ_WRITE_TOKEN=""

# Cloudflare R2 (dash.cloudflare.com → R2 → API tokens)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
